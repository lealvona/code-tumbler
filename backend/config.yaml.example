active_provider: ollama_local
providers:
  ollama_local:
    type: ollama
    base_url: http://localhost:11434
    model: llama3.1:8b
    context_length: 32768
    cost_per_1k_input_tokens: 0.0
    cost_per_1k_output_tokens: 0.0
    temperature: 0.7
    timeout: 300
    concurrency_limit: 2
    retry_max_attempts: 2
    retry_base_delay: 1.0
  vllm_local:
    type: vllm
    base_url: http://localhost:8000
    model: meta-llama/Llama-3.1-70B-Instruct
    context_length: 128000
    cost_per_1k_input_tokens: 0.0
    cost_per_1k_output_tokens: 0.0
    temperature: 0.7
    timeout: 300
    concurrency_limit: 7
    retry_max_attempts: 3
    retry_base_delay: 1.0
  openai_gpt4:
    type: openai
    model: gpt-4o
    cost_per_1k_input_tokens: 0.0025
    cost_per_1k_output_tokens: 0.01
    temperature: 0.7
    timeout: 300
    retry_max_attempts: 3
    retry_base_delay: 1.0
  anthropic_sonnet:
    type: anthropic
    model: claude-sonnet-4-5-20250929
    cost_per_1k_input_tokens: 0.003
    cost_per_1k_output_tokens: 0.015
    temperature: 0.7
    timeout: 300
    retry_max_attempts: 3
    retry_base_delay: 1.0
  gemini_flash:
    type: gemini
    model: gemini-2.5-flash
    cost_per_1k_input_tokens: 0.0
    cost_per_1k_output_tokens: 0.0
    temperature: 0.7
    timeout: 300
  claude_opus_cli:
    type: claude_cli
    model: claude-opus-4-8
    context_length: 200000
    cost_per_1k_input_tokens: 0.0
    cost_per_1k_output_tokens: 0.0
    timeout: 600
    extra_params:
      effort: high
  kimi_k3:
    type: openai
    base_url: https://api.moonshot.ai/v1
    model: kimi-k3
    api_key_env: KIMI_API_KEY
    context_length: 1000000
    cost_per_1k_input_tokens: 0.00095
    cost_per_1k_output_tokens: 0.004
    temperature: 0.7
    timeout: 600
    concurrency_limit: 4
tumbler:
  max_iterations: 10
  quality_threshold: 95
  project_timeout: 3600
  debounce_time: 3
  max_cost_per_project: 0.0
  prompt_compression:
    enabled: true
    rate: 0.5
    preserve_code_blocks: true
agent_providers: null
agent_nothink: null
database:
  url: postgresql://tumbler:changeme@localhost:5432/tumbler
  pool_size: 5
  max_overflow: 10
logging:
  level: INFO
  format: json
  file: logs/tumbler.log
verification:
  sandbox_enabled: true
  timeout_install: 300
  timeout_build: 300
  timeout_test: 120
  timeout_lint: 60
  memory_limit: 2g
  cpu_limit: 1.0
  tmpfs_size: 512m
  network_install: true
  network_verify: false
workspace:
  base_path: ./projects
  auto_archive: true
