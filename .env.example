# Code Tumbler — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env
#
# This file holds SECRETS and DOCKER NETWORKING overrides only.
# All other settings live in backend/config.yaml.

# ── Cloud API Keys (leave blank if not using) ───────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Custom / Self-Hosted Endpoint ───────────────────────────
# e.g., Open WebUI proxy to a local vLLM backend
CUSTOM_API_KEY=

# ── Local LLM Base URLs ────────────────────────────────────
# Only needed if your Ollama/vLLM is on a different host.
# Inside Docker these default to host.docker.internal automatically.
# OLLAMA_BASE_URL=http://localhost:11434
# VLLM_BASE_URL=http://localhost:8000

# ── Docker auto-recovery (optional) ─────────────────────────
# Command the backend runs to revive the Docker daemon if it is unreachable
# when sandbox verification starts (it then waits up to 60s and retries).
# Example for a host-run backend using Docker Desktop on Linux:
# DOCKER_RECOVERY_CMD=systemctl --user start docker-desktop
